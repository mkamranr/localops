# ---------------------------------------------------------------------------
# LocalOps environment configuration (copy to .env and edit).
# Never commit .env — it contains secrets.
# ---------------------------------------------------------------------------
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME
LOG_LEVEL=INFO

# Public HTTP port exposed by the nginx reverse proxy
LOCALOPS_HTTP_PORT=8300

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=localops
# Superuser used only by the postgres container itself
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Schema owner, used only by migrations
LOCALOPS_OWNER_PASSWORD=CHANGE_ME
# Runtime role (no superuser, no BYPASSRLS) used by api/worker
LOCALOPS_APP_PASSWORD=CHANGE_ME

# --- Auth --------------------------------------------------------------------
AUTH_MODE=local
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Set to false only for local plain-HTTP testing
COOKIE_SECURE=false
ENABLE_REGISTRATION=false
ENABLE_TELEMETRY=false

# --- Bootstrap (first start) ---------------------------------------------
# Creates the "system" tenant and a Super Administrator if they don't exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@localops.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Also create a "default" tenant for regular users
BOOTSTRAP_CREATE_DEFAULT_TENANT=true

# --- LLM (not used yet: model gateway arrives in Phase 2) -------------------
LLM_PROVIDER=vllm
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=local-model
