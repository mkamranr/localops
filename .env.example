# ---------------------------------------------------------------------------
# LocalOps environment configuration (copy to .env and edit).
# Never commit .env — it contains secrets.
# ---------------------------------------------------------------------------
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME
LOG_LEVEL=INFO

# Public HTTP port exposed by the nginx reverse proxy (redirects to HTTPS with TLS)
LOCALOPS_HTTP_PORT=8300
# HTTPS port, used with docker-compose.tls.yml (see docs/installation.md#https)
LOCALOPS_HTTPS_PORT=8443
# Compose files to use, e.g. docker-compose.yml:docker-compose.tls.yml (set by install.sh)
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=localops
# Superuser used only by the postgres container itself
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Schema owner, used only by migrations
LOCALOPS_OWNER_PASSWORD=CHANGE_ME
# Runtime role (no superuser, no BYPASSRLS) used by api/worker
LOCALOPS_APP_PASSWORD=CHANGE_ME

# --- Auth --------------------------------------------------------------------
AUTH_MODE=local
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Keep true behind HTTPS (docker-compose.tls.yml sets it). false only for plain-HTTP testing;
# production logs a warning at startup when it is false.
COOKIE_SECURE=false
ENABLE_REGISTRATION=false
ENABLE_TELEMETRY=false

# --- Bootstrap (first start) ---------------------------------------------
# Creates the "system" tenant and a Super Administrator if they don't exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@localops.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Also create a "default" tenant for regular users
BOOTSTRAP_CREATE_DEFAULT_TENANT=true

# --- Secrets at rest ------------------------------------------------------
# Encrypts model API keys and integration credentials (SSH keys, passwords, TLS keys)
# in the database. REQUIRED in production: the services refuse to start without a valid key.
# Back it up separately: losing it means re-entering stored secrets. Generate with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
LOCALOPS_ENCRYPTION_KEY=

# --- AI model (optional seed) ----------------------------------------------
# Models are managed in the UI (Settings -> AI Models). If LLM_BASE_URL and LLM_MODEL
# are set, bootstrap creates a default endpoint for every tenant that has none.
# Any OpenAI-compatible server works: ollama | vllm | llamacpp | openai_compatible.
# A model server on the Docker host itself is reachable as host.docker.internal
# (Ollama must listen on 0.0.0.0: OLLAMA_HOST=0.0.0.0).
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_MODEL=
# e.g. LLM_BASE_URL=http://host.docker.internal:11434   LLM_MODEL=qwen2.5:14b-instruct
#      LLM_BASE_URL=http://gpu-node-01:8000/v1          LLM_MODEL=Qwen/Qwen2.5-14B-Instruct

# --- Knowledge base (phase 6) -----------------------------------------------------
# Embedding model for semantic search (optional seed; also managed in Settings ->
# AI Models with purpose "Embedding"). Without one, knowledge search is keyword-only.
# e.g. EMBEDDING_BASE_URL=http://host.docker.internal:11434  EMBEDDING_MODEL=nomic-embed-text
#      (run `ollama pull nomic-embed-text` on the model host first)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
KNOWLEDGE_MAX_UPLOAD_MB=10
# Chunk size and overlap (characters) used when indexing documents.
KNOWLEDGE_CHUNK_CHARS=2400
KNOWLEDGE_CHUNK_OVERLAP=300
# --- MCP servers (phase 6) ---------------------------------------------------------
# Default timeout for MCP tool calls (per integration override in the UI).
MCP_DEFAULT_TIMEOUT_SECONDS=30

# --- Investigations -----------------------------------------------------------
INVESTIGATION_TIMEOUT_SECONDS=1800
INVESTIGATION_MAX_CLARIFICATIONS=2
# Read-only diagnostic tool runs allowed per investigation, and how much of each
# tool's (redacted) output a model sees.
INVESTIGATION_MAX_TOOL_CALLS=30
TOOL_OUTPUT_MODEL_BYTES=6000

# --- Incidents ------------------------------------------------------------------
# Open an incident automatically when discovery or a health check sees a resource
# turn unhealthy (one open incident per resource).
INCIDENT_AUTO_CREATE=true

# --- Remediation (phase 5) -------------------------------------------------------
# Kill switch: false stops every remediation action at execution time, even approved ones.
REMEDIATION_ENABLED=true
# Steps the Remediation Planner may propose per investigation.
REMEDIATION_MAX_STEPS=3
# How long an approval request stays open (policies can override per action).
APPROVAL_DEFAULT_TTL_MINUTES=60
# Wait before the Verification agent re-checks a system after an action.
VERIFICATION_DELAY_SECONDS=5

# --- Infrastructure discovery ---------------------------------------------------
# Targets collected in parallel per discovery run, and the per-integration target cap.
DISCOVERY_CONCURRENCY=8
DISCOVERY_MAX_TARGETS=500
# Resource metric samples (taken on each discovery run) are kept this long.
METRIC_RETENTION_DAYS=30

# --- Resource limits (optional) ----------------------------------------------
# POSTGRES_MEM_LIMIT=2g
# QDRANT_MEM_LIMIT=2g
# REDIS_MEM_LIMIT=512m
# API_MEM_LIMIT=2g
# WORKER_MEM_LIMIT=2g
